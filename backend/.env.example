# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO debe subirse a git (ya esta en .gitignore).

# Perfil de Spring activo (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Conexion a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/stockcontrol
DB_USERNAME=stockcontrol
DB_PASSWORD=stockcontrol

# Puerto del backend
SERVER_PORT=8080

# --- Solo necesarios en produccion (perfil prod) ---
# En prod son OBLIGATORIOS: si faltan o conservan el valor de desarrollo,
# el backend se niega a arrancar (ver config/ProductionConfigGuard).

# Secreto JWT: aleatorio, minimo 32 caracteres (ej. `openssl rand -base64 48`)
#JWT_SECRET=

# Contrasena del administrador inicial que se crea en el primer arranque
# (minimo 8 caracteres y distinta de 'admin123')
#ADMIN_USERNAME=admin
#ADMIN_PASSWORD=

# Origines CORS explicitos, separados por coma, sin localhost
#CORS_ALLOWED_ORIGINS=https://inventario.domio.co

# Duracion del token JWT en minutos (por defecto 480 = 8 horas)
#JWT_EXPIRATION_MINUTES=480
