# Copia este archivo como .env y ajusta los valores.
# El archivo .env NO debe subirse a git (ya esta en .gitignore).

# Perfil de Spring activo (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Conexion a PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/stockcontrol
DB_USERNAME=stockcontrol
DB_PASSWORD=stockcontrol

# Puerto del backend
SERVER_PORT=8080
